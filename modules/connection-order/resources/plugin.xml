  <menuContribution locationURI="menu:window?after=additions"><command commandId="com.salutem.jasper.gestaoImport" label="Importar Conexões do Gestão…" style="push"/><command commandId="com.salutem.jasper.accounts" label="Contas de Banco de Dados e JasperServer…" style="push"/></menuContribution>
 </extension>
</plugin>
