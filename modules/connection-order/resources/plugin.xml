<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
 <extension point="org.eclipse.ui.startup"><startup class="com.salutem.order.Startup"/></extension>
 <extension point="org.eclipse.ui.commands"><command id="com.salutem.jasper.gestaoImport" name="Importar Conexões do Gestão"/><command id="com.salutem.jasper.accounts" name="Contas de Banco de Dados e JasperServer" description="Cadastrar contas separadas para preencher conexões"/></extension>
 <extension point="org.eclipse.ui.handlers"><handler commandId="com.salutem.jasper.gestaoImport" class="com.salutem.order.GestaoImportHandler"/><handler commandId="com.salutem.jasper.accounts" class="com.salutem.order.AccountsHandler"/></extension>
 <extension point="org.eclipse.ui.menus">
