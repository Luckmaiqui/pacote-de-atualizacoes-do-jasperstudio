<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
 <extension point="org.eclipse.e4.ui.css.swt.theme">
  <theme id="com.salutem.jasper.theme.deepblue" label="Salutem Noite" basestylesheeturi="css/salutem-noite.css"/>
  <themeAssociation themeId="com.salutem.jasper.theme.deepblue" colorAndFontId="org.eclipse.ui.defaultTheme"/>
  <theme id="com.salutem.jasper.theme.graphite" label="Salutem Grafite" basestylesheeturi="css/salutem-grafite.css"/>
  <themeAssociation themeId="com.salutem.jasper.theme.graphite" colorAndFontId="org.eclipse.ui.defaultTheme"/>
  <theme id="com.salutem.jasper.theme.forest" label="Salutem Floresta" basestylesheeturi="css/salutem-floresta.css"/>
  <themeAssociation themeId="com.salutem.jasper.theme.forest" colorAndFontId="org.eclipse.ui.defaultTheme"/>
  <theme id="com.salutem.jasper.theme.plum" label="Salutem Ameixa" basestylesheeturi="css/salutem-ameixa.css"/>
  <themeAssociation themeId="com.salutem.jasper.theme.plum" colorAndFontId="org.eclipse.ui.defaultTheme"/>
  <theme id="com.salutem.jasper.theme.github" label="Salutem GitHub" basestylesheeturi="css/salutem-github.css"/>
  <themeAssociation themeId="com.salutem.jasper.theme.github" colorAndFontId="org.eclipse.ui.defaultTheme"/>
  <theme id="com.salutem.jasper.theme.onyx" label="Salutem Ônix" basestylesheeturi="css/salutem-onyx.css"/>
  <themeAssociation themeId="com.salutem.jasper.theme.onyx" colorAndFontId="org.eclipse.ui.defaultTheme"/>
  <theme id="com.salutem.jasper.theme.midnight" label="Salutem Meia-Noite" basestylesheeturi="css/salutem-midnight.css"/>
  <themeAssociation themeId="com.salutem.jasper.theme.midnight" colorAndFontId="org.eclipse.ui.defaultTheme"/>
 </extension>
 <extension point="org.eclipse.ui.startup"><startup class="com.salutem.theme.Startup"/></extension>
 <extension point="org.eclipse.ui.commands"><command id="com.salutem.theme.pickBlockColor" name="%command.pickBlockColor" description="%command.pickBlockColor.description" categoryId="org.eclipse.ui.category.window"/></extension>
 <extension point="org.eclipse.ui.handlers"><handler commandId="com.salutem.theme.pickBlockColor" class="com.salutem.theme.PickBlockHandler"/></extension>
 <extension point="org.eclipse.ui.menus"><menuContribution locationURI="menu:window?after=additions"><command commandId="com.salutem.theme.pickBlockColor" label="%command.pickBlockColor" style="push"/></menuContribution></extension>
 <extension point="org.eclipse.ui.preferencePages"><page id="com.salutem.theme.customColors" name="%page.customColors" category="org.eclipse.ui.preferencePages.Views" class="com.salutem.theme.CustomColorsPage"/></extension>
</plugin>
